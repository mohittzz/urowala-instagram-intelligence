# ==============================================================================
# UROWALA Instagram Reel Intelligence - Environment Variables
# Target Domain: socialmedia.urowala.com / analytics.urowala.com
# Account: @dr.mohit_urowala
# ==============================================================================

# Apify Instagram Scraping (Recommended for quick, zero-hurdle ingestion)
# Get from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token
TARGET_INSTAGRAM_USERNAME=dr.mohit_urowala

# Meta Instagram Graph API (Optional Alternative: Developers Portal -> App Settings -> Basic)
INSTAGRAM_APP_ID=your_meta_app_id
INSTAGRAM_APP_SECRET=your_meta_app_secret
INSTAGRAM_REDIRECT_URI=https://socialmedia.urowala.com/api/auth/instagram/callback

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Vercel Cron Security Secret (Passed in 'Authorization: Bearer <CRON_SECRET>')
CRON_SECRET=generate_a_random_32_character_string_here

# App Domain
NEXT_PUBLIC_APP_URL=https://socialmedia.urowala.com
